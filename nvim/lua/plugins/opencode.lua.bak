return {
  "nickjvandyke/opencode.nvim",
  version = "*",
  config = function()
    vim.o.autoread = true

    local opencode = require("opencode")

    vim.keymap.set("n", "<leader>at", function()
      local opencode = require("opencode")
      opencode.toggle()
      vim.defer_fn(function()
        for _, win in ipairs(vim.api.nvim_list_wins()) do
          local buf = vim.api.nvim_win_get_buf(win)
          if vim.bo[buf].buftype == "terminal" then
            vim.api.nvim_set_current_win(win)
            vim.cmd("startinsert")
            break
          end
        end
      end, 100)
    end, { desc = "Toggle opencode", silent = true })

    vim.keymap.set("n", "<leader>af", function()
      local file = vim.fn.expand("%:~")
      local server = require("opencode.server").get()
      server:next(function(s)
        vim.defer_fn(function()
          s:tui_append_prompt("@" .. file, function()
            s:tui_execute_command("prompt.submit")
          end)
        end, 500)
      end)
    end, { desc = "Send current file to opencode" })

    vim.keymap.set("x", "<leader>as", function()
      local lines = vim.api.nvim_buf_get_lines(0, 0, -1, false)
      local selected = table.concat(lines, "\n")
      local server = require("opencode.server").get()
      server:next(function(s)
        vim.defer_fn(function()
          s:tui_append_prompt("@this " .. selected, function()
          end)
        end, 500)
      end)
    end, { desc = "Send full file to opencode" })

    vim.keymap.set("n", "<leader>al", function()
      local line = vim.fn.getline(".")
      opencode.ask("@this " .. line, { submit = true })
    end, { desc = "Send line to opencode" })

    vim.keymap.set("n", "<leader>a-", function()
      opencode.command("session.half.page.down")
    end, { desc = "Scroll opencode down" })

    vim.keymap.set("n", "<leader>a+", function()
      opencode.command("session.half.page.up")
    end, { desc = "Scroll opencode up" })

    vim.keymap.set("t", "<Esc>", "<C-\\><C-n>", { desc = "Exit terminal mode" })
  end,
}

